#!/usr/bin/env python3
"""silicon-agent remote client. Submits a spec to the job server and streams progress.

    sa ask "a 32-tap lowpass FIR on Spartan-7 at 250 MS/s, few DSPs"   natural language -> run, streamed
    sa ask "make it faster" --thread <thread-id>                         refine / ask about an earlier run
    sa submit specs/matmul_int8.json [--max-iter 8] [--backend ecp5|xc7s50]
    sa watch <job-id>
    sa list
    sa get <job-id> <file>          e.g. summary.json, iter_02.json, llm_01.json

Server: SA_SERVER (default http://127.0.0.1:8765). Token: SA_TOKEN.
Pure standard library; no local toolchain needed.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request

SERVER = os.environ.get("SA_SERVER", "http://127.0.0.1:8765").rstrip("/")
TOKEN = os.environ.get("SA_TOKEN", "")


def req(method: str, path: str, body: dict | None = None):
    data = json.dumps(body).encode() if body is not None else None
    r = urllib.request.Request(f"{SERVER}{path}", data=data, method=method,
                               headers={"Content-Type": "application/json", **({"Authorization": f"Bearer {TOKEN}"} if TOKEN else {})})
    try:
        with urllib.request.urlopen(r, timeout=60) as resp:
            ct = resp.headers.get("Content-Type", "")
            raw = resp.read()
            return json.loads(raw) if "json" in ct else raw.decode()
    except urllib.error.HTTPError as e:
        sys.exit(f"{method} {path}: HTTP {e.code} {e.read().decode()[:300]}")
    except urllib.error.URLError as e:
        sys.exit(f"cannot reach {SERVER}: {e.reason}  (is the SSH tunnel up? see README)")


def fmt_event(ev: dict) -> str:
    t = f"[{ev['t']:6.0f}s]"
    k = ev["kind"]
    if k == "evaluating":
        return f"{t} [{ev['iteration']}] evaluating {json.dumps(ev['ir'])}"
    if k == "result":
        m = ev["metrics"]
        v = ev["violations"]
        status = "FEASIBLE" if not v else "violations: " + "; ".join(v)
        return (f"{t}      fmax={m['fmax_mhz']:.1f} MHz  lut={m['lut']}  dsp={m['dsp']}  ff={m['ff']}  "
                f"sim={'ok' if m['sim_passed'] else 'FAIL'}  {status}  ({ev['eda_seconds']}s)")
    if k == "plan":
        s = f"{t}      diagnosis: {ev['diagnosis']}\n{' ' * 9}      action:    {'[fallback] ' if ev.get('fallback') else ''}{ev['action']}"
        for c in ev.get("candidates", []):
            e = c.get("estimate")
            tag = f"REJECTED {c['rejected']}" if c.get("rejected") else (f"est ~{e['fmax_mhz']:.0f} MHz ~{e['lut']} LUT ~{e['dsp']} DSP" + (" " + ",".join(c["est_violations"]) if c.get("est_violations") else " ok") if e else "")
            s += f"\n{' ' * 15} #{c.get('rank', 'x')} {json.dumps(c['ir'])}  {tag}"
        return s + ("\n" + " " * 15 + "planner says stop." if ev.get("stop") else "")
    if k == "memory":
        return f"{t}      memory: recalled {len(ev['lessons'])} lesson(s) " + ", ".join(f"{l['id']}({l['score']:+.1f})" for l in ev["lessons"])
    if k == "lesson":
        L = ev["lesson"]
        return f"{t}      lesson [{L['id']}] {L['outcome']}: {L['text']}"
    if k == "stage":
        return f"{t}      sim {ev['stage']}: {'pass' if ev['passed'] else 'FAIL' if ev['passed'] is False else 'skipped'} @ {ev.get('period_ns', '?')} ns"
    if k == "user":
        return f"{t}      you: {ev['message']}"
    if k == "steer":
        return f"{t}      (your {len(ev['messages'])} message(s) go into the next plan)"
    if k == "rescreen":
        return f"{t}      all candidates estimated infeasible; re-planning with the verdicts"
    if k == "done":
        b = ev["best"]
        if not b:
            return f"{t} === RESULT: FAIL, no feasible design in {ev['iterations']} iterations ==="
        m = b["metrics"]
        return (f"{t} === RESULT: PASS after {ev['iterations']} iterations ===\n"
                f"         ir={json.dumps(b['ir'])}\n"
                f"         fmax={m['fmax_mhz']:.1f} MHz  lut={m['lut']}  ff={m['ff']}  dsp={m['dsp']}  "
                f"throughput={b['throughput']} {ev.get('throughput_unit', '')}  latency={b['latency_cycles']} cycles")
    return f"{t} {json.dumps(ev)}"


def watch(job_id: str) -> int:
    seen = 0
    while True:
        j = req("GET", f"/jobs/{job_id}?after={seen}")
        for ev in j["events"]:
            print(fmt_event(ev), flush=True)
        seen = j["n_events"]
        if j["status"] in ("done", "failed", "error"):
            if j.get("error"):
                print(f"server error:\n{j['error']}")
            print(f"job {job_id}: {j['status']}   (artifacts: sa get {job_id} summary.json)")
            return 0 if j["status"] == "done" else 1
        time.sleep(3)


def ask(text: str, thread: str | None) -> int:
    before = len(req("GET", f"/threads/{thread}")["messages"]) if thread else 0
    r = req("POST", f"/threads/{thread or 'new'}/chat", {"text": text})
    tid = r["thread"]
    print(f"thread {tid}", flush=True)
    shown, job_seen, job = before + 1, 0, None  # skip history and our own message
    while True:
        th = req("GET", f"/threads/{tid}")
        for m in th["messages"][shown:]:
            if m["role"] == "assistant":
                print(f"\n{m['text']}\n", flush=True)
                if m.get("kind") == "run":
                    job, job_seen = m["job"], 0
        shown = len(th["messages"])
        if job:
            j = req("GET", f"/jobs/{job}?after={job_seen}")
            for ev in j["events"]:
                print(fmt_event(ev), flush=True)
            job_seen = j["n_events"]
            if j["status"] not in ("queued", "running") and any(m.get("kind") == "report" and m.get("job") == job for m in th["messages"]):
                return 0 if j["status"] == "done" else 1
        elif not th.get("busy"):
            return 0
        time.sleep(3)


def main() -> int:
    ap = argparse.ArgumentParser(prog="sa")
    sub = ap.add_subparsers(dest="cmd", required=True)
    k = sub.add_parser("ask"); k.add_argument("text"); k.add_argument("--thread")
    s = sub.add_parser("submit"); s.add_argument("spec"); s.add_argument("--max-iter", type=int, default=8)
    s.add_argument("--backend", choices=["ecp5", "xc7s50"]); s.add_argument("--no-watch", action="store_true")
    sub.add_parser("list")
    w = sub.add_parser("watch"); w.add_argument("job_id")
    g = sub.add_parser("get"); g.add_argument("job_id"); g.add_argument("file")
    sub.add_parser("health")
    a = ap.parse_args()

    if a.cmd == "health":
        print(json.dumps(req("GET", "/health")))
        return 0
    if a.cmd == "ask":
        return ask(a.text, a.thread)
    if a.cmd == "list":
        for j in req("GET", "/jobs"):
            print(f"{j['id']}  {j['status']:8s}  {j.get('design', 'matmul'):6s} {j['backend']:7s}  {j['task']}")
        return 0
    if a.cmd == "submit":
        spec = json.load(open(a.spec))
        if a.backend:
            spec["backend"] = a.backend
        r = req("POST", "/jobs", {"spec": spec, "max_iter": a.max_iter})
        print(f"submitted {r['id']}  design={spec.get('design', 'matmul')}  backend={spec.get('backend', 'ecp5')}  server={SERVER}")
        return 0 if a.no_watch else watch(r["id"])
    if a.cmd == "watch":
        return watch(a.job_id)
    if a.cmd == "get":
        out = req("GET", f"/jobs/{a.job_id}/files/{a.file}")
        print(json.dumps(out, indent=2) if isinstance(out, (dict, list)) else out)
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
