# silicon-agent: copy to .env and fill in. Never commit .env.
# The access token: the browser types it once (login page), the CLI / MCP / AGH plugin send it as Bearer.
SA_TOKEN=change-me-to-a-long-random-string
# DeepSeek API key (platform.deepseek.com): the planner and the Agnes Harness agent run on DeepSeek.
DEEPSEEK_API_KEY=sk-...
# Where the server is reachable from a browser (links in webhooks and exports).
SA_PUBLIC_URL=http://localhost:8765
# Bind address of the published port: 127.0.0.1 (default, SSH tunnel / local use) or 0.0.0.0 behind your own TLS proxy.
SA_BIND=127.0.0.1
SA_PORT=8765
# Runs in flight at once (each is CPU-bound on the EDA tools).
SA_WORKERS=2
# 1: every login sees every conversation (a single team); 0: per login subject.
SA_SHARED=1
# Optional: the sky130 ASIC backend (docker compose --profile asic up -d).
SA_ASIC_ENABLE=0
