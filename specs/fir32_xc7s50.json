{
  "task": "32-tap 16-bit lowpass FIR, Spartan-7, 250 MHz, few DSPs",
  "target": "AMD Spartan-7 XC7S50-1",
  "design": "fir",
  "backend": "xc7s50",
  "locked": {
    "taps": 32,
    "data_width": 16,
    "coef_width": 16
  },
  "constraints": {
    "fmax_mhz": 250,
    "max_dsp": 8,
    "max_lut": 3000,
    "objective": [
      "maximize_throughput",
      "minimize_lut"
    ]
  },
  "initial_ir": {
    "symmetric": false,
    "fold": 1,
    "acc_width": 40,
    "pipe_mul": 0,
    "reg_in": false,
    "dsp_regs": "none"
  }
}